# Copy to .env and fill in real values
# Note: the +psycopg2 dialect is required; SQLAlchemy 2.0 defaults plain
# postgresql:// URLs to the psycopg (v3) driver, which is not installed.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/maintenance
S3_BUCKET=
S3_REGION=us-east-1
CORS_ORIGINS=http://localhost:5173
